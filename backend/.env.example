# ==========================================================
# SMART COLD STORAGE: ENVIRONMENT CONFIGURATION
# ==========================================================

# Database Config (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_cold_storage

# SMS Provider Configuration ('FAST2SMS' | 'MSG91' | 'TWILIO' | 'MOCK')
SMS_PROVIDER=MOCK
SMS_API_KEY=your_fast2sms_or_msg91_api_key_here
SMS_SENDER_ID=FSTSMS
SMS_TEMPLATE_ID=your_dlt_template_id_here

# Twilio (Alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security
SECRET_KEY=your_super_secret_jwt_key_here
OTP_EXPIRY_MINUTES=5
MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=45
