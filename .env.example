# ====================================================================
# SMART COLD STORAGE: ENVIRONMENT CONFIGURATION
# ====================================================================

# Mode: 'production' | 'development'
# In production, real SMS OTP is dispatched and debug OTPs are never exposed.
OTP_MODE=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_cold_storage

# SMS Gateway Provider Selection ('FAST2SMS' | 'MSG91' | 'TWILIO' | 'MOCK')
SMS_PROVIDER=FAST2SMS

# 1. Fast2SMS Credentials (India DLT/OTP Gateway)
# Sign up at https://www.fast2sms.com to get your API key
SMS_API_KEY=your_fast2sms_api_key_here
SMS_SENDER_ID=FSTSMS

# 2. MSG91 Credentials (India Enterprise Telecom Gateway)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# 3. Twilio Credentials (International Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Security Settings
SECRET_KEY=your_super_secret_jwt_encryption_key_here
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
